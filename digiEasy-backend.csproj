<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>digiEasy_backend</RootNamespace>
    <AssemblyName>digiEasy-backend</AssemblyName>
    <!-- Debug: no native apphost exe → one fewer file to overwrite during build (dotnet run still loads the DLL). -->
    <UseAppHost Condition="'$(Configuration)' == 'Debug'">false</UseAppHost>
  </PropertyGroup>

  <!-- Faster Debug builds / quicker first JIT (does not skip `dotnet run`’s default build step; see README). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <TieredCompilationQuickJit>true</TieredCompilationQuickJit>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.32" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <!-- Test project lives under this folder; exclude it from all default globs (compile, content, etc.). -->
  <ItemGroup>
    <Compile Remove="digiEasy-backend.Tests/**" />
    <Content Remove="digiEasy-backend.Tests/**" />
    <EmbeddedResource Remove="digiEasy-backend.Tests/**" />
    <None Remove="digiEasy-backend.Tests/**" />
  </ItemGroup>

</Project>
